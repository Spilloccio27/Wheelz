# Copia questo file in .env e compila le due variabili per passare
# dalla MODALITÀ DEMO (dati in memoria) alla persistenza su Supabase.
#
# Senza queste variabili l'app parte in modalità demo:
# nessuna chiamata di rete, dati generati da un RNG con seed.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Lunghezza minima password: deve coincidere con il valore impostato in
# Supabase → Authentication → Providers → Email → Minimum password length
VITE_MIN_PASSWORD_LENGTH=10

# Solo per lo script `npm run seed` (mai esposta al browser).
# Service role key: Supabase → Project Settings → API → service_role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
